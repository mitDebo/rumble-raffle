# Postgres connection string — Supabase's session pooler (not the direct
# connection or transaction pooler; see backend/README.md for why).
ConnectionStrings__Default=

# Base Supabase project URL, e.g. https://<project-ref>.supabase.co
# Used to build the JWKS endpoint for JWT validation:
# {Supabase__Url}/auth/v1/.well-known/jwks.json
Supabase__Url=
