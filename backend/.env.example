# Postgres connection string — Supabase's session pooler (not the direct
# connection or transaction pooler; see backend/README.md for why).
ConnectionStrings__Default=

# Base Supabase project URL, e.g. https://<project-ref>.supabase.co
# Used to build the JWKS endpoint for JWT validation:
# {Supabase__Url}/auth/v1/.well-known/jwks.json
Supabase__Url=

# Supabase Storage's secret key (Settings > API Keys > Secret keys in the
# dashboard -- the new key type, not the legacy service_role key, which
# Supabase is deprecating by end of 2026). Only needed once a real bucket
# exists and something actually uploads through SupabaseImageStorage (1.9)
# -- see 5.2 in spec/openspec/changes/rumble-raffle-mvp/tasks.md. Leave
# blank until then; nothing in the app requires it yet.
Supabase__StorageSecretKey=
